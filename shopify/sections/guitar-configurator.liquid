{{ 'guitar-configurator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'guitar-configurator.js' | asset_url }}" defer></script>

{%- assign base_product = section.settings.product -%}

<section class="gc" data-guitar-configurator id="GuitarConfigurator-{{ section.id }}">
  <div class="gc-preview">
    <div class="gc-stage" data-gc-stage>
      {%- if section.settings.base_image != blank -%}
        {{ section.settings.base_image | image_url: width: 1400 | image_tag: class: 'gc-base', alt: base_product.title, loading: 'eager' }}
      {%- endif -%}
      <div class="gc-layers" data-gc-layers></div>
    </div>
  </div>

  <div class="gc-panel">
    <h2 class="gc-title">{{ section.settings.heading | default: base_product.title }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="gc-subtitle">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div data-gc-options></div>

    <div class="gc-summary">
      <ul data-gc-summary></ul>
      <div class="gc-total"><span>Total</span><span data-gc-total></span></div>
      <div class="gc-actions">
        <button type="button" class="gc-btn" data-gc-add>{{ section.settings.button_label }}</button>
        <button type="button" class="gc-btn gc-btn--secondary" data-gc-share>Share build</button>
      </div>
      <p class="gc-message" data-gc-message role="status" aria-live="polite"></p>
    </div>
  </div>

  <script type="application/json" data-configurator-config>
    {
      "sectionId": {{ section.id | json }},
      "currency": {{ cart.currency.iso_code | json }},
      "locale": {{ request.locale.iso_code | json }},
      "baseImage": {% if section.settings.base_image != blank %}true{% else %}false{% endif %},
      "product": {% if base_product %}{
        "title": {{ base_product.title | json }},
        "variantId": {{ base_product.selected_or_first_available_variant.id | json }},
        "price": {{ base_product.selected_or_first_available_variant.price | json }}
      }{% else %}null{% endif %},
      "choices": [
        {%- for block in section.blocks -%}
          {%- assign up = block.settings.upcharge_product -%}
          {
            "group": {{ block.settings.group | json }},
            "label": {{ block.settings.label | json }},
            "slot": {{ block.settings.slot | json }},
            "swatch": {% if block.settings.swatch != blank %}"{{ block.settings.swatch }}"{% else %}null{% endif %},
            "thumb": {% if block.settings.swatch_image != blank %}{{ block.settings.swatch_image | image_url: width: 120 | json }}{% else %}null{% endif %},
            "image": {% if block.settings.layer_image != blank %}{{ block.settings.layer_image | image_url: width: 1400 | json }}{% else %}null{% endif %},
            "upchargeVariantId": {% if up %}{{ up.selected_or_first_available_variant.id | json }}{% else %}null{% endif %},
            "upchargePrice": {% if up %}{{ up.selected_or_first_available_variant.price | json }}{% else %}0{% endif %},
            "isDefault": {{ block.settings.is_default | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Guitar configurator",
  "tag": "div",
  "class": "section-guitar-configurator",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Base product",
      "info": "The guitar being configured. Its price is the starting price."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Defaults to the product title."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Build yours. Every Lark is made to order."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add build to cart"
    },
    {
      "type": "image_picker",
      "id": "base_image",
      "label": "Base photo (optional)",
      "info": "A background photo for the guitar. When set, the drawn placeholder is hidden and option layer images stack on top. All layer images must be the same size and angle."
    }
  ],
  "blocks": [
    {
      "type": "choice",
      "name": "Option choice",
      "settings": [
        {
          "type": "text",
          "id": "group",
          "label": "Option group",
          "default": "Body finish",
          "info": "Choices with the same group name are shown together, e.g. 'Body finish'."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Choice name",
          "default": "Cherry red"
        },
        {
          "type": "select",
          "id": "slot",
          "label": "Part of the guitar it changes",
          "options": [
            { "value": "body", "label": "Body" },
            { "value": "pickguard", "label": "Pickguard" },
            { "value": "fretboard", "label": "Fretboard" },
            { "value": "headstock", "label": "Headstock" },
            { "value": "pickups", "label": "Pickups" },
            { "value": "hardware", "label": "Hardware" }
          ],
          "default": "body"
        },
        {
          "type": "color",
          "id": "swatch",
          "label": "Colour",
          "default": "#9e1b22"
        },
        {
          "type": "image_picker",
          "id": "swatch_image",
          "label": "Swatch image (optional)",
          "info": "A small texture, like a wood grain or burst, shown instead of the colour dot."
        },
        {
          "type": "image_picker",
          "id": "layer_image",
          "label": "Preview layer image (optional)",
          "info": "Transparent PNG of just this part, same size and angle as the base photo."
        },
        {
          "type": "product",
          "id": "upcharge_product",
          "label": "Upcharge product (optional)",
          "info": "A hidden product priced at the extra cost of this option. Leave empty if it's included."
        },
        {
          "type": "checkbox",
          "id": "is_default",
          "label": "Selected by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guitar configurator",
      "blocks": [
        { "type": "choice", "settings": { "group": "Body finish", "label": "Cherry red", "slot": "body", "swatch": "#9e1b22", "is_default": true } },
        { "type": "choice", "settings": { "group": "Body finish", "label": "Seafoam", "slot": "body", "swatch": "#8fcfbf" } },
        { "type": "choice", "settings": { "group": "Body finish", "label": "Midnight blue", "slot": "body", "swatch": "#1d2b4f" } },
        { "type": "choice", "settings": { "group": "Pickguard", "label": "Black", "slot": "pickguard", "swatch": "#1a1a1a", "is_default": true } },
        { "type": "choice", "settings": { "group": "Pickguard", "label": "Parchment", "slot": "pickguard", "swatch": "#f2f0ea" } },
        { "type": "choice", "settings": { "group": "Hardware", "label": "Chrome", "slot": "hardware", "swatch": "#c7cbd0", "is_default": true } },
        { "type": "choice", "settings": { "group": "Hardware", "label": "Gold", "slot": "hardware", "swatch": "#caa54f" } }
      ]
    }
  ]
}
{% endschema %}
